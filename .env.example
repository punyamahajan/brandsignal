# =============================================================================
# BrandSignal Environment Configuration
# =============================================================================
# Rename this file to .env or edit .env directly in the project root (D:\BrandSignal\.env).
# BrandSignal works 100% out of the box with the deterministic hybrid engine
# even without any API keys. Adding keys enables live cloud LLM reasoning and
# external public research adapters.

# -----------------------------------------------------------------------------
# 1. LLM Reasoning Providers (Choose one or more)
# -----------------------------------------------------------------------------
# Google Gemini (Recommended - google-genai SDK installed)
GEMINI_API_KEY=
# or
GOOGLE_API_KEY=

# Anthropic Claude (anthropic SDK installed)
ANTHROPIC_API_KEY=

# OpenAI (if installed)
OPENAI_API_KEY=

# Model overrides (optional)
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
# OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# 2. Public Research & Search Providers (Optional)
# -----------------------------------------------------------------------------
# SerpAPI (for Google Web Search & Competitor Discovery)
SERPAPI_API_KEY=

# YouTube Data API v3 (for Video Reviews & Creator Metadata)
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# 3. Application & Logging Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
